@model IEnumerable<InterfaceTestDev.Models.EstoqueProduto>

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4"><strong>GRUPO KYLY</strong></h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<h2>Produtos</h2>

<a asp-action="Create" class="btn btn btn-success mb-3">
    Novo Produto
</a>


<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Referência</th>
            <th>Saldo</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Referencia</td>
                <td>@item.SaldoEstoque</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn btn-primary btn-sm">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        Excluir
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>